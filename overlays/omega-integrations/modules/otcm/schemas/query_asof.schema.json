{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OTCM As-Of Query",
  "type": "object",
  "required": [
    "valid_at_utc",
    "known_at_utc",
    "branch_id"
  ],
  "properties": {
    "valid_at_utc": {
      "type": "integer"
    },
    "known_at_utc": {
      "type": "integer"
    },
    "cognitive_seq_limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "branch_id": {
      "type": "string"
    },
    "simulation_at_utc": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}