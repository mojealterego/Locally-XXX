{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "element_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "CHARACTER",
        "OBJECT",
        "LOCATION"
      ]
    },
    "canonical_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^asset://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "rights_confirmed": {
            "const": true
          }
        },
        "required": [
          "uri",
          "sha256",
          "rights_confirmed"
        ]
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "project_scope": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "is_stale": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "description_source": {
      "enum": [
        "manual",
        "generated"
      ]
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string"
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "is_stale": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": [
          "template",
          "source_revision",
          "is_stale",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "element_id",
    "kind",
    "canonical_name",
    "refs",
    "owner",
    "project_scope",
    "revision",
    "is_stale"
  ],
  "$id": "https://omega.local/spec/v1/element.schema.json"
}
