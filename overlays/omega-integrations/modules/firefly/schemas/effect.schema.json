{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "effect": {
      "enum": [
        "bloom",
        "bokehBlur",
        "cartoon",
        "colorhalftone",
        "dither",
        "duotone",
        "glitch",
        "grain",
        "lensDistortion",
        "mosaic",
        "motionBlur",
        "noise",
        "pixelate",
        "radialBlur",
        "threshold",
        "tritone",
        "tritoneSepia",
        "twirl"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "effect",
    "params",
    "seed"
  ],
  "$id": "https://omega.local/spec/v1/effect.schema.json"
}
