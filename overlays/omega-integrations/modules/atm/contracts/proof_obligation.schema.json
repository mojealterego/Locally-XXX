{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATM ProofObligation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_digest": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "minLength": 1
    },
    "assumptions_digest": {
      "type": "string",
      "minLength": 1
    },
    "kernel_version": {
      "type": "string",
      "minLength": 1
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "checker_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "obligation_id",
    "tenant_id",
    "claim_digest",
    "source_digest",
    "assumptions_digest",
    "kernel_version",
    "timeout_ms",
    "checker_id"
  ]
}
