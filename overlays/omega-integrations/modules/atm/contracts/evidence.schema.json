{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATM EvidenceEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "assertion": {
      "type": "boolean"
    },
    "valid_from": {
      "type": "integer"
    },
    "valid_to": {
      "type": [
        "integer",
        "null"
      ]
    },
    "recorded_at": {
      "type": "integer"
    },
    "taint": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "UNTRUSTED",
        "QUARANTINED"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "tenant_id",
    "claim_id",
    "source_id",
    "assertion",
    "valid_from",
    "recorded_at",
    "taint",
    "digest"
  ]
}
