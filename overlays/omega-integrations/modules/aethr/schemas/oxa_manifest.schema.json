{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://omega.local/schemas/aethr/oxa.v1.json",
  "title":"AETHR OXA1 canonical manifest",
  "type":"object",
  "required":["format","profile","artifacts"],
  "additionalProperties":false,
  "properties":{
    "format":{"const":"oxa.v1"},
    "profile":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "artifacts":{"type":"array","minItems":1,"maxItems":64,"items":{
      "type":"object","required":["name","size","sha256"],"additionalProperties":false,
      "properties":{
        "name":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
        "size":{"type":"integer","minimum":0,"maximum":17592186044416},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }}
  }
}
