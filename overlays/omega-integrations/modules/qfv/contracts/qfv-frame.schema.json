{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qfv/frame/v1",
  "title": "QFV Tracked Face Frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "timestampNs",
    "landmarkSet",
    "landmarks",
    "blendshapes",
    "confidence",
    "consent"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "timestampNs": {
      "type": "integer",
      "minimum": 0
    },
    "landmarkSet": {
      "enum": [
        "mediapipe-478",
        "mobile-68-projection"
      ]
    },
    "landmarks": {
      "type": "array",
      "minItems": 68,
      "maxItems": 478,
      "items": {
        "$ref": "#/$defs/vec3"
      }
    },
    "blendshapes": {
      "type": "object",
      "maxProperties": 52,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "consent": {
      "enum": [
        "on-device-processing"
      ]
    },
    "frameProvenanceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "landmarkSet": {
            "const": "mediapipe-478"
          }
        },
        "required": [
          "landmarkSet"
        ]
      },
      "then": {
        "properties": {
          "landmarks": {
            "minItems": 478,
            "maxItems": 478
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "landmarkSet": {
            "const": "mobile-68-projection"
          }
        },
        "required": [
          "landmarkSet"
        ]
      },
      "then": {
        "properties": {
          "landmarks": {
            "minItems": 68,
            "maxItems": 68
          }
        }
      }
    }
  ]
}
