{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.local/schemas/continuum/adapter_manifest.v1.schema.json",
  "title": "OmegOS Continuum — Tool Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "backend_family", "image_digest", "binary_sha256", "supported_languages", "proof_formats", "allow_network", "max_memory_mib", "max_wall_seconds", "trusted_as_checker"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "backend_family": {"enum": ["SMT", "KERNEL", "MODEL_CHECKER", "PROGRAM_VERIFIER", "CPS", "HDL", "ZK"]},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "supported_languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 48}},
    "proof_formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 48}},
    "allow_network": {"type": "boolean"},
    "max_memory_mib": {"type": "integer", "minimum": 64, "maximum": 262144},
    "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "trusted_as_checker": {"type": "boolean"}
  }
}
