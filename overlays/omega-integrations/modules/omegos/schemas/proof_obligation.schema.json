{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega.local/schemas/continuum/proof_obligation.v1.schema.json",
  "title": "OmegOS Continuum — Proof Obligation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "obligation_id", "tenant_id", "goal_language", "goal", "source_sha256", "spec_sha256", "assumptions_sha256", "toolchain_lock_sha256", "semantic_profile", "dependencies", "timeout_seconds", "requested_assurance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "obligation_id": {"type": "string", "pattern": "^CONT-PO-[0-9]{4,12}$"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "goal_language": {"enum": ["SMT_LIB2", "LEAN4", "ROCQ", "WHY3", "TLA_PLUS", "VERUS", "KANI", "KEYMAERA_X", "HDL"]},
    "goal": {"type": "string", "minLength": 5, "maxLength": 1048576},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "spec_sha256": {"$ref": "#/$defs/hash"},
    "assumptions_sha256": {"$ref": "#/$defs/hash"},
    "toolchain_lock_sha256": {"$ref": "#/$defs/hash"},
    "semantic_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"},
    "dependencies": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "pattern": "^CONT-PO-[0-9]{4,12}$"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "requested_assurance": {"enum": ["SOLVER_RESULT", "CHECKED_PROOF", "BINARY_LINKED", "HARDWARE_LINKED"]}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
