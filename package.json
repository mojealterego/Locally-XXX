    "runtime:recoverable-render": "python3 -m scripts.recoverable_render",
    "test:broker": "python3 -m unittest discover -s tests -p test_resource_broker.py -v",
    "test:recovery": "python3 -m unittest discover -s tests -p test_recoverable_render.py -v"
