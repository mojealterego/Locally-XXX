    "rag:prepare": "node scripts/rag-overlay.mjs",
    "test:rag-browser": "python3 tests/rag-browser.py",
    "security:scan": "python3 -m scripts.security_scan",
    "omega:restore": "python3 -m scripts.omega_import",
