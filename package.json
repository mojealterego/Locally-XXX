    "lint": "node scripts/upstream-gate.mjs lint",
    "test:unit": "node scripts/upstream-gate.mjs test:unit",
    "test:e2e": "node scripts/upstream-gate.mjs test:e2e",
    "tauri:build": "node scripts/upstream-gate.mjs tauri:build",
    "test:gate": "node --test tests/*.test.mjs",
    "vendor:dry": "node scripts/vendorize.mjs --dry-run",
    "vendor:apply": "node scripts/vendorize.mjs --apply",
    "vendor:check": "node scripts/vendorize.mjs --check",
    "models:inventory": "node scripts/gguf-inventory.mjs",
    "vendor:verify-pinned": "node scripts/snapshot-integrity.mjs",
    "stage:check": "node scripts/staged-runtime.mjs check",
