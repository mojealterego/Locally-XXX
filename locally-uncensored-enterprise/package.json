{
  "name": "locally-uncensored-enterprise",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm run test:ui",
    "test:ui": "node --test test/*.test.mjs",
    "build:web": "node apps/web/build.mjs",
    "start:web": "node apps/web/serve.mjs",
    "test:phase3": "node --test test/visual.test.mjs test/codespace.test.mjs",
    "training": "node backend/scripts/training.mjs",
    "test:operations": "node --test backend/test/enterprise-services.test.mjs",
    "test:integrations": "node --test integrations/test/integrations.test.mjs",
    "business:mcp": "node integrations/bin/business-mcp.mjs",
    "knowledge": "node integrations/bin/knowledge-cli.mjs",
    "json:format": "node integrations/bin/json-fmt.mjs",
    "test:catalog-context": "node --test test/next-increment.test.mjs test/legacy-context-regression.test.mjs"
  }
}
